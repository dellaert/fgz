fgz 1
# Root poses at four successive events
variable X_0 (0, 2)
variable X_1 (3, 2)
variable X_2 (6, 2)
variable X_3 (9, 2)

# One variable per stance, shared by all poses that observe it
variable L_0 (1.5, 0)
variable R_0 (4.5, -1)
variable L_1 (9, 0)

factor {X_0, X_1} shape=square
factor {X_1, X_2} shape=square
factor {X_2, X_3} shape=square

factor {X_0, L_0} shape=square color=red
factor {X_1, L_0} shape=square color=red
factor {X_1, R_0} shape=square color=green
factor {X_2, R_0} shape=square color=green
factor {X_3, L_1} shape=square color=red
